# ==============================================================================
# UMUM Marketplace Platform - Environment Configuration (.env.example)
# ==============================================================================

# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-umum-marketplace-super-secret-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL 16)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=umum_db
DB_USER=umum_user
DB_PASSWORD=umum_secret_password
DB_HOST=127.0.0.1
DB_PORT=5432
USE_SQLITE_DEV=True

# Redis & Channels Configuration
REDIS_URL=redis://127.0.0.1:6379/0

# Payme Merchant API Configuration
PAYME_MERCHANT_ID=mock_merchant_id_12345
PAYME_SECRET_KEY=mock_secret_key_67890
PAYME_TEST_MODE=True

# SMS Provider Configuration (Eskiz.uz)
SMS_PROVIDER=mock
ESKIZ_EMAIL=info@umum.uz
ESKIZ_PASSWORD=mock_eskiz_password
ESKIZ_TOKEN=mock_eskiz_jwt_token

# AI Assistant Integration (Gemini / OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here

# Media and Static Storage
MEDIA_URL=/media/
STATIC_URL=/static/

# Secret Secure Admin Portal URL (FR-20 Security Hardening)
DJANGO_ADMIN_URL=portal-manager-7x9q/
